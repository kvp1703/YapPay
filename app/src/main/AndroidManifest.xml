<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed by SpeechRecognizer. Requested at runtime the first time the mic button is tapped. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Online speech recognition. Normal permission, granted automatically. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: without this, SpeechRecognizer.isRecognitionAvailable()
         returns false and recognition silently fails. DO NOT REMOVE. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ExpenseApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YapPay">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.YapPay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Launched only by the widget's PendingIntent. It uses its own task affinity so finishing
            the capture returns to the home screen, never to a stale in-app screen.
        -->
        <activity
            android:name=".widget.QuickCaptureActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.yappay.app.quickcapture"
            android:theme="@style/Theme.YapPay.QuickCapture"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />

        <receiver
            android:name=".widget.ExpenseWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/expense_widget_info" />
        </receiver>
    </application>

</manifest>
