<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Brand + auto-save cue -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_diamond" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:maxLines="1"
                android:text="@string/widget_brand"
                android:textAllCaps="true"
                android:textColor="@color/widget_gold"
                android:textSize="8.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/widget_auto_saves"
            android:textAllCaps="true"
            android:textColor="@color/widget_muted"
            android:textSize="7.5sp" />
    </LinearLayout>

    <!-- Today / this month / mic -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="@string/widget_today"
                android:textAllCaps="true"
                android:textColor="@color/widget_muted"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_today_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_zero"
                android:textColor="@color/widget_ink"
                android:textSize="28sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_divider" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="56dp">

            <LinearLayout
                android:id="@+id/widget_month_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:text="@string/widget_this_month"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_muted"
                    android:textSize="8.5sp" />

                <TextView
                    android:id="@+id/widget_month_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_zero"
                    android:textColor="@color/widget_ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/widget_month_caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:maxLines="1"
                    android:textColor="@color/widget_faint"
                    android:textSize="8sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_hint_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/widget_pill"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.10"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="2"
                    android:text="@string/widget_tap_to_speak"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_gold"
                    android:textSize="9sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_orb"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/widget_tap_to_speak">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_orb_glow" />

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_orb_ring" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_orb" />

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_mic"
                android:tint="@color/widget_orb_ink" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
