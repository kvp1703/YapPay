<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Warm gold bloom in the top-right, falling into near-black ink. -->
    <gradient
        android:centerColor="#1D1915"
        android:centerX="0.86"
        android:centerY="0.02"
        android:endColor="#0B0A09"
        android:gradientRadius="340dp"
        android:startColor="#51432D"
        android:type="radial" />
    <corners android:radius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#45C9A96A" />
</shape>
